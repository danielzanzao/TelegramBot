# Arquivo de exemplo para configuração do EnactusBOT
# Copie este arquivo para .env e preencha com suas credenciais reais

# ========================================
# CONFIGURAÇÕES OBRIGATÓRIAS
# ========================================

# Token do Bot do Telegram (obrigatório)
# Obtenha em: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# ========================================
# CONFIGURAÇÕES OPCIONAIS - GOOGLE SHEETS
# ========================================

# Credenciais do Google Service Account (JSON completo em uma linha)
# Para integração com Google Sheets
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"seu-projeto",...}

# ID da planilha do Google Sheets para sincronização
# Exemplo: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# ENACTUS_SPREADSHEET_ID=1xyz...

# ========================================
# CONFIGURAÇÕES DE LINKS
# ========================================

# Link para o drive da Central Enactus
CENTRAL_ENACTUS_LINK=https://drive.google.com/drive/folders/1pFo4CP_LVCaI2hdQQyyKVr4IQfXTH204

# Link para pesquisa de clima organizacional
CLIMATE_SURVEY_LINK=https://forms.google.com/seu-formulario-aqui

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Fuso horário para lembretes
TIMEZONE=America/Sao_Paulo

# ========================================
# NOTAS DE CONFIGURAÇÃO
# ========================================

# 1. TELEGRAM_BOT_TOKEN é obrigatório para o bot funcionar
# 2. Google Sheets é opcional - se não configurado, os dados ficam apenas na memória
# 3. Para configurar gerentes, edite o arquivo data_models.py
# 4. Use /get_my_id no bot para descobrir IDs do Telegram
# 5. Nunca commite o arquivo .env com credenciais reais!